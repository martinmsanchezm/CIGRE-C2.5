# Copy this file to iacigre/core/.env and fill in your own values.
# Never commit the real .env file.

# --- Django ---
SECRET_KEY=change-me
# True only for local development
DEBUG=False
# Comma-separated list
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# 1 = SQLite (iacigre/db.sqlite3), 0 = PostgreSQL (fill ENV_DB_* below)
DEFAULT_BD=1
ENV_DB_NAME=
ENV_DB_USER=
ENV_DB_PASSWORD=
ENV_DB_HOST=
ENV_DB_PORT=

# --- App ---
# Base folder for uploaded photos (photos/project/, photos/section/, photos/user/)
ENV_MEDIA_PATH=media/
# User ids of the root/admin account and the guest account
ENV_ROOT_ID=1
ENV_INVITADO_ID=2

# Extra allowed origins for CORS/CSRF
ENV_URL_PORT_1=http://localhost:3000
ENV_URL_PORT_2=http://localhost:8000

# --- Email (only read when DEBUG=False) ---
DEFAULT_FROM_EMAIL=CIGRE C2.5 <no-reply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_PORT=587
EMAIL_USE_TLS=True
