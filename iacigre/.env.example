# Copy this file to iacigre/.env (read by Create React App at build time).
# Never commit the real .env file. Note: REACT_APP_* values end up in the
# public JavaScript bundle, so the guest account must have read-only rights.

REACT_APP_API_URL=http://localhost:8000
# Must match ENV_INVITADO_ID in core/.env
REACT_APP_INVITADO_ID=2
REACT_APP_INVITADO_EMAIL=guest@example.com
REACT_APP_INVITADO_PASSWORD=change-me
# 1 = show coordinators' email on the About page
REACT_APP_SHOW_EMAIL_ADMIN=0
